      <!-- Clase Prestamo -->
      <packagedElement xmi:type="uml:Class" xmi:id="Class_Prestamo" name="Prestamo">
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_P_id" name="id" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_P_cid" name="cliente_id*" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_P_cap" name="capital_inicial_cents*" visibility="private"/>
