        <ownedAttribute xmi:type="uml:Property" xmi:id="Attr_G_updated" name="updated_at" visibility="private"/>
      </packagedElement>

      <!-- Asociaciones -->
      <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Cliente_Contacto" name="tiene_contactos">
        <memberEnd xmi:idref="End_Cliente_Contacto_C"/>
        <memberEnd xmi:idref="End_Cliente_Contacto_Ct"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="End_Cliente_Contacto_C" type="Class_Cliente" lower="1" upper="1"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="End_Cliente_Contacto_Ct" type="Class_Contacto" lower="0" upper="*"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Association" xmi:id="Assoc_Cliente_Prestamo" name="posee_prestamos">
